# ============================================================
#  金融问答系统 - 配置模板
#
#  使用方法：
#    1. 复制本文件为 .env
#    2. 填入你的 LLM API Key（必填）
#    3. 如需自定义模型路径，修改下方对应项
#
#  检查配置是否正确：python -m src.pipeline config
# ============================================================

# ------------------------------------------------------------
#  LLM API（必填）
#
#  支持任意 OpenAI 兼容接口，以下是常见选择：
# ------------------------------------------------------------

# 【DeepSeek 官方】https://platform.deepseek.com/
# 性价比高，中文金融理解好，国内可直连
LLM_API_KEY=sk-在此填入你的Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 【阿里通义千问】https://dashscope.console.aliyun.com/
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 【智谱 GLM】https://open.bigmodel.cn/
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# 【月之暗面 Kimi】https://platform.moonshot.cn/
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# 【本地网关 / Ollama / vLLM 等自建服务】
# LLM_API_KEY=not-needed
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b

# ------------------------------------------------------------
#  模型路径（可选）
#
#  留空则自动查找，查找顺序：
#    1. 项目根目录下的 models/bge-m3（推荐，clone 后自包含）
#    2. 常见缓存目录（~/.cache/huggingface、D:/hf_cache 等）
#
#  首次使用请运行：python tools/download_models.py
# ------------------------------------------------------------
EMBEDDING_MODEL_PATH=
RERANKER_MODEL_PATH=

# ------------------------------------------------------------
#  检索参数（可选，一般无需修改）
# ------------------------------------------------------------
# 粗排召回数量（向量与 BM25 各自召回多少条）
TOP_K_RECALL=20
# 精排后送入 LLM 的片段数
TOP_K_FINAL=5
# 是否启用重排模型（显存不足时可设为 0）
ENABLE_RERANK=1
